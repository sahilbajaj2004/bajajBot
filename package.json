{
  "name": "bajajbot",
  "version": "3.2.0",
  "description": "Terminal AI chat client",
  "author": "Sahil Bajaj <Sahilbajaj2004@gmail.com>",
  "type": "module",
  "bin": {
    "bajajbot": "dist/bin/bajajbot.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/bajajbot.ts",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm test",
    "stream": "tsx scripts/stream.ts",
    "smoke": "tsx scripts/smoke.tsx",
    "tabs": "tsx scripts/tabkeys.tsx && tsx scripts/tabmouse.tsx && tsx scripts/tabwrite.tsx && tsx scripts/tabsmoke.tsx && tsx scripts/tabgradient.tsx",
    "queue": "tsx scripts/queueprompts.tsx",
    "notes": "tsx scripts/tabnotes.tsx",
    "submodel": "tsx scripts/subagentmodel.tsx",
    "reload": "tsx scripts/reloadcfg.tsx",
    "verbosity": "tsx scripts/verbosity.tsx",
    "update": "tsx scripts/update.tsx"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.3.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "README.md"
  ]
}
